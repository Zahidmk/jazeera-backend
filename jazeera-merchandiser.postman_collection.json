                "v1",
                "merchandiser",
                "attendance",
                "status"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Check-in",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "selfie",
                  "type": "file",
                  "src": [],
                  "description": "JPEG or PNG, max 5 MB"
                },
                {
                  "key": "latitude",
                  "value": "24.7136",
                  "type": "text"
                },
                {
                  "key": "longitude",
                  "value": "46.6753",
                  "type": "text"
                },
                {
                  "key": "accuracy",
                  "value": "12.5",
                  "type": "text"
                },
                {
                  "key": "deviceId",
                  "value": "postman-device-0001",
                  "type": "text"
                },
                {
                  "key": "deviceName",
                  "value": "Postman",
                  "type": "text"
                },
                {
                  "key": "biometricVerified",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "biometricMethod",
                  "value": "fingerprint",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/merchandiser/attendance/check-in",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "merchandiser",
                "attendance",
                "check-in"
              ]
            },
            "description": "multipart/form-data. biometricVerified must be true. A merchandiser's first deviceId is auto-approved; other devices get 403 DEVICE_NOT_APPROVED."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.success) { const v = j.data.id; if (v) pm.collectionVariables.set('attendance_id', v); }"
                ]
              }
            }
          ]
        },
