{
  "info": {
    "name": "Jazeera Merchandiser API (Phase 2)",
    "description": "Base URL defaults to production (http://147.93.96.94:5000) — change the base_url collection variable for another environment. The Admin folders are for the dashboard and are not needed by the mobile app. Merchandiser mobile app + admin management endpoints. Run \"Merchandiser Login\" (and \"Admin Login\") first — tokens are saved to collection variables. Check-in / check-out need a selfie file chosen in the form-data body. See MERCHANDISER_API_GUIDE.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{merch_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://147.93.96.94:5000"
    },
    {
      "key": "merch_token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "shop_id",
      "value": ""
    },
    {
      "key": "visit_id",
      "value": ""
    },
    {
      "key": "attendance_id",
      "value": ""
    },
    {
      "key": "feedback_id",
      "value": ""
    },
    {
      "key": "device_row_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Merchandiser Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"YOUR_MERCHANDISER_EMAIL\",\n  \"password\": \"YOUR_PASSWORD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.success && j.data && j.data.token) pm.collectionVariables.set('merch_token', j.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"YOUR_ADMIN_EMAIL\",\n  \"password\": \"YOUR_PASSWORD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.success && j.data && j.data.token) pm.collectionVariables.set('admin_token', j.data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Merchandiser App — Attendance",
      "item": [
        {
          "name": "Attendance status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/merchandiser/attendance/status",
              "host": [
