# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jazeera_db?schema=public"

# ─── Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Odoo ERP ─────────────────────────────────────────────
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your_odoo_database_name
ODOO_USERNAME=api_user@company.com
ODOO_API_KEY=your_odoo_api_key_here
# REQUIRED: the webhook rejects all requests (503) when this is empty. Odoo must send it as X-Odoo-Webhook-Secret.
ODOO_WEBHOOK_SECRET=CHANGE_THIS_TO_A_STRONG_32_CHAR_SECRET
ODOO_SCRAP_LOCATION_ID=14

# ─── Customer-specific pricing ────────────────────────────
# Prices come from Odoo's vansales.integration.service.get_last_sale_price
# (one RPC per product, ~290 ms each), so answers are cached and fanned out.
# All optional — the defaults below are used when unset.
CUSTOMER_PRICE_CACHE_TTL_MS=600000   # how long a resolved price stays cached (10 min)
CUSTOMER_PRICE_CONCURRENCY=8         # parallel Odoo price lookups per request
CUSTOMER_PRICE_MAX_LOOKUPS=100       # cap per request; products beyond it keep the list price

# ─── File Uploads ─────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── CORS ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3001,https://dashboard.jazeera.com
